# Anomaly Desk environment. Copy to .env and fill in. .env is gitignored.

# Model backend selection, per README.md section 4.
#   api   = hosted Anthropic API. The default and the scored configuration.
#   local = quantized model behind the same interface, for offline development only.
MODEL_BACKEND=api

# Required when MODEL_BACKEND=api. A13, the judge harness, cannot run without it,
# and hard rule 1 makes the judge a prerequisite for every agent.
ANTHROPIC_API_KEY=

# PostgreSQL, which also holds the vector index via pgvector.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=anomalydesk
POSTGRES_USER=anomalydesk
# Development credential. Safe behind the loopback default above; change it before setting
# BIND_ADDRESS to anything else.
POSTGRES_PASSWORD=anomalydesk

# Kafka, single broker in KRaft mode.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_EVENTS_TOPIC=events
KAFKA_DLQ_TOPIC=events.dlq
KAFKA_CONSUMER_GROUP=anomalydesk-triage

# OpenTelemetry, per README.md section 11.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=anomaly-desk

# Interface the stack publishes on. The default is loopback, so nothing here is reachable
# from the local network. A Compose mapping written as "5432:5432" binds 0.0.0.0 instead,
# which on an untrusted network exposes PostgreSQL with the development password below and
# a Kafka broker with no authentication.
#
# Set this to 0.0.0.0 only when you deliberately need another device to reach the stack, and
# change POSTGRES_PASSWORD at the same time if you do. A weak password behind loopback is
# fine; a weak password on 0.0.0.0 is not.
BIND_ADDRESS=127.0.0.1

# Host ports. The defaults are what README.md section 15 specifies and are correct on a
# clean machine. Override any of them when another stack on this host already holds the
# port; make up runs a preflight check that names the conflicting container and the
# variable to set.
API_PORT=8000
UI_PORT=3000
KAFKA_PORT=9092
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
