  "cards": [
    {
      "dot": "cyan",
      "title": "Typed contracts",
      "items": [
        "Every hop returns a schema the next stage validates",
        "A violation is counted and reported, never reinterpreted",
        "Free-text handoffs between agents are prohibited"
      ]
    },
    {
      "dot": "rose",
      "title": "Untrusted event text",
      "items": [
        "Classifier and drafting agents hold no tools at all",
        "Retrieval holds one read-only search tool",
        "Side-effecting actions need operator confirmation in the orchestrator, never in a prompt"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two scoreboards, both reported",
      "items": [
        "Judge score comes from rubrics and verified citation spans",
        "Override rate comes from real operator dispositions",
        "When they disagree the disagreement is written up, not resolved by preference"
      ]
    },
    {
      "dot": "amber",
      "title": "Consolidated from the specification",
      "items": [
        "pgvector runs inside PostgreSQL, so state is one node",
        "Producer and replayer are one path differing only in offset source",
        "Observability is cross-cutting and carried here rather than as nodes"
      ]
    }
  ]
