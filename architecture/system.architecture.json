  "diagram_type": "architecture",
  "meta": {
    "title": "Anomaly Desk",
    "subtitle": "Agentic triage of a streaming event feed, scored by a judge and by the operator override rate",
    "output": "docs/architecture.html",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "triage-path",
        "label": "One event through triage",
        "focus": [
          "sources",
          "producer",
          "kafka",
          "consumer",
          "orch"
        ],
        "note": "The main path: a pinned source event is normalized, replayed at a fixed offset, and validated before any agent sees it."
      },
      {
        "id": "typed-hops",
        "label": "Typed contracts between agents",
        "focus": [
          "orch",
          "classifier",
          "retriever",
          "drafter"
        ],
        "note": "Every hop returns a schema the next stage validates. A violation is counted, never reinterpreted."
      },
      {
        "id": "two-scoreboards",
        "label": "Two scoreboards that may disagree",
        "focus": [
          "judge",
          "board",
          "console",
          "store"
        ],
        "note": "The judge scores rubrics and citation spans; the override rate comes from real operator dispositions."
      },
      {
        "id": "human-loop",
        "label": "Nothing is silently dropped",
        "focus": [
          "orch",
          "policy",
          "console"
        ],
        "note": "Escalation is policy in configuration, and every failure path ends in an operator queue entry."
      }
    ]
  },
