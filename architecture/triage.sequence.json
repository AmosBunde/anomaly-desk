  "cards": [
    {
      "dot": "cyan",
      "title": "Typed contracts",
      "items": [
        "Classification, Evidence, and Draft are validated schemas",
        "A violation is counted and ends the triage in the operator queue",
        "No stage receives free text from the stage before it"
      ]
    },
    {
      "dot": "emerald",
      "title": "Idempotency first",
      "items": [
        "The claim precedes any agent work",
        "A redelivered event is skipped rather than triaged twice",
        "Replay of a fixed offset list is therefore safe to repeat"
      ]
    },
    {
      "dot": "rose",
      "title": "Nothing is dropped",
      "items": [
        "Escalation is read from versioned policy by the orchestrator",
        "A step budget exhaustion still produces a queue entry",
        "Tokens and cost are persisted with the triage, not derived later"
      ]
    }
  ]
