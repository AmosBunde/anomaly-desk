{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Anomaly Desk triage sequence",
    "subtitle": "One event from Kafka offset to persisted triage, with typed hops and a guaranteed queue entry",
    "output": "docs/triage-sequence.html",
    "viewBox": [
      1120,
      900
    ],
    "quality_profile": "showcase",
    "visual_preset": "blueprint",
    "views": [
      {
        "id": "claim",
        "label": "Claim before work",
        "focus": [
          "kafka",
          "consumer",
          "store"
        ],
        "note": "An event is claimed by idempotency key before triage begins, so a redelivery cannot produce a second triage."
      },
      {
        "id": "typed-hops",
        "label": "Typed hops",
        "focus": [
          "orch",
          "classifier",
          "retriever",
          "drafter"
        ],
        "note": "Each agent returns a schema the orchestrator validates. A violation is counted and ends the triage in the queue."
      },
      {
        "id": "never-dropped",
        "label": "Never silently dropped",
        "focus": [
          "orch",
          "queue",
          "store"
        ],
        "note": "Escalation is decided by the orchestrator reading versioned policy, and every failure path still reaches an operator."
      }
    ]
  },
  "participants": [
    {
      "id": "kafka",
      "type": "messagebus",
      "label": "Kafka",
      "sublabel": "topic: events"
    },
    {
      "id": "consumer",
      "type": "backend",
      "label": "Consumer",
      "sublabel": "idempotency, retry"
    },
    {
      "id": "orch",
